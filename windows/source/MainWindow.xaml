<Window
    x:Class="FluentNotepad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FluentNotepad"
    mc:Ignorable="d">

    <local:CursorGrid x:Name="Root">
        <local:CursorGrid.Resources>
            <!-- TabView draws a 1px line under the strip: Notepad doesn't have it -->
            <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
            <!-- Shared card look for the floating overlays (find bar, preview error) -->
            <Style x:Key="OverlayCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <!-- Thin dividers in the status bar -->
            <Style x:Key="StatusSep" TargetType="Rectangle">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            </Style>
        </local:CursorGrid.Resources>
        <Grid.RowDefinitions>
            <!-- 46 not 48: the strip must end exactly where the tab ends,
                 otherwise a 2px gray stripe remains under the tab -->
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TITLE BAR with TabView (like Notepad) ===== -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="Transparent">
            <controls:TabView
                xmlns:controls="using:Microsoft.UI.Xaml.Controls"
                x:Name="Tabs" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Margin="4,6,150,0"
                VerticalAlignment="Stretch"
                IsAddTabButtonVisible="True" CanReorderTabs="True" CanDragTabs="True"
                AddTabButtonClick="Tabs_AddTab" TabCloseRequested="Tabs_Close"
                SelectionChanged="Tabs_SelectionChanged">
                <controls:TabView.TabStripHeader>
                    <Image Source="Assets/AppIcon.ico" Width="16" Height="16" Margin="8,0,4,0"/>
                </controls:TabView.TabStripHeader>
            </controls:TabView>
        </Grid>

        <!-- ===== MENU + FORMATTING (white/black veil over Mica like Notepad) ===== -->
        <Grid x:Name="MenuRow" Grid.Row="1" Padding="8,0,4,0" BorderThickness="0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <MenuBar Height="32" Padding="0" VerticalAlignment="Center" FontSize="14">
                <MenuBarItem x:Uid="MenuFile" Title="File">
                    <MenuFlyoutItem x:Uid="FileNewTab" Text="Nuova scheda" Click="NewTab_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="T" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="FileNewWindow" Text="Nuova finestra" Click="NewWindow_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control,Shift"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="FileOpen" Text="Apri…" Click="Open_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="FileSave" Text="Salva" Click="Save_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="FileSaveAs" Text="Salva con nome…" Click="SaveAs_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="FileCloseTab" Text="Chiudi scheda" Click="CloseTab_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="W" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="FilePrint" Text="Stampa…" Click="Print_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="P" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="FileExit" Text="Esci" Click="Exit_Click"/>
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuEdit" Title="Modifica">
                    <!-- No Ctrl+Z/Y/X/C/V/A accelerators here on purpose: RichEditBox
                         (and the find TextBox) already handle them natively, and a
                         menu accelerator would fire IN ADDITION (double paste/cut/undo).
                         Click handlers below stay for mouse/menu use. -->
                    <MenuFlyoutItem x:Uid="EditUndo" Text="Annulla" Click="Undo_Click"/>
                    <MenuFlyoutItem x:Uid="EditRedo" Text="Ripeti" Click="Redo_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="EditCut" Text="Taglia" Click="Cut_Click"/>
                    <MenuFlyoutItem x:Uid="EditCopy" Text="Copia" Click="Copy_Click"/>
                    <MenuFlyoutItem x:Uid="EditPaste" Text="Incolla" Click="Paste_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="EditFind" Text="Trova…" Click="Find_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="EditSelectAll" Text="Seleziona tutto" Click="SelectAll_Click"/>
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuView" Title="Visualizza">
                    <MenuFlyoutItem x:Uid="ViewZoomIn" Text="Aumenta zoom" Click="ZoomIn_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Add" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="ViewZoomOut" Text="Riduci zoom" Click="ZoomOut_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Subtract" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="ViewZoomReset" Text="Ripristina zoom" Click="ZoomReset_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number0" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="ViewPreview" Text="Anteprima Markdown" Click="PreviewToggle_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="V" Modifiers="Control,Shift"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="ViewWrap" Text="A capo automatico" Click="Wrap_Click"/>
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuHelp" Title="?">
                    <MenuFlyoutItem x:Uid="HelpShortcuts" Text="Scorciatoie da tastiera" Click="Shortcuts_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F1"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="HelpAbout" Text="Informazioni su FluentNotepad" Click="About_Click"/>
                </MenuBarItem>
            </MenuBar>

            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed"
                        OverflowButtonVisibility="Collapsed" HorizontalAlignment="Center"
                        Height="36" Padding="0" VerticalAlignment="Center">
                <AppBarButton x:Uid="FmtHeading" Content="H" FontFamily="Segoe UI" FontWeight="Bold" Width="36" Height="36" ToolTipService.ToolTip="Titolo (#)" Click="FormatHeading_Click"/>
                <AppBarButton x:Uid="FmtBold" Content="B" FontFamily="Segoe UI" FontWeight="Bold" Width="36" Height="36" ToolTipService.ToolTip="Grassetto (**testo**)" Click="FormatBold_Click"/>
                <AppBarButton x:Uid="FmtItalic" Content="I" FontFamily="Segoe UI" FontStyle="Italic" Width="36" Height="36" ToolTipService.ToolTip="Corsivo (*testo*)" Click="FormatItalic_Click"/>
                <AppBarButton x:Uid="FmtStrike" Content="S" FontFamily="Segoe UI" Width="36" Height="36" ToolTipService.ToolTip="Barrato (~~testo~~)" Click="FormatStrike_Click"/>
                <AppBarButton x:Uid="FmtLink" Width="36" Height="36" ToolTipService.ToolTip="Link [testo](url)" Click="FormatLink_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="FmtQuote" Content="&#x275D;" FontFamily="Segoe UI" Width="36" Height="36" ToolTipService.ToolTip="Citazione (> )" Click="FormatQuote_Click"/>
                <AppBarButton x:Uid="FmtBullets" Width="36" Height="36" ToolTipService.ToolTip="Elenco puntato (- )" Click="FormatBullets_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="FmtNumbers" Content="1." FontFamily="Segoe UI" Width="36" Height="36" ToolTipService.ToolTip="Elenco numerato (1. )" Click="FormatNumbers_Click"/>
                <AppBarButton x:Uid="FmtCode" Content="{}{ }" FontFamily="Consolas" Width="36" Height="36" ToolTipService.ToolTip="Codice (`testo`)" Click="FormatCode_Click"/>
            </CommandBar>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Uid="EditModeBtn" x:Name="EditModeBtn" Visibility="Collapsed" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="EditMode_Click" ToolTipService.ToolTip="Modalità modifica">
                    <PathIcon Width="15" Height="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Data="M17.1813 2.92689C16.029 1.71505 14.1046 1.69077 12.9222 2.87317L3.54735 12.2475C3.21952 12.5754 2.99198 12.9899 2.89142 13.4424L2.0138 17.3923C1.97672 17.5592 2.02748 17.7335 2.14838 17.8544C2.26928 17.9753 2.44356 18.026 2.61044 17.9889L6.53683 17.1157C7.00426 17.0118 7.43237 16.7767 7.77096 16.4381L17.129 7.08003C18.27 5.939 18.2932 4.09631 17.1813 2.92689ZM13.6293 3.58029C14.4142 2.79538 15.6917 2.8115 16.4566 3.61596C17.1947 4.39225 17.1793 5.61548 16.4218 6.37293L15.7506 7.04418L12.958 4.25155L13.6293 3.58029ZM12.2508 4.95864L15.0435 7.7513L7.06385 15.731C6.8597 15.9352 6.60158 16.0769 6.31975 16.1396L3.16044 16.8421L3.86762 13.6593C3.92692 13.3924 4.0611 13.148 4.25444 12.9547L12.2508 4.95864Z"/>
                </Button>
                <Button x:Uid="PreviewModeBtn" x:Name="PreviewModeBtn" Visibility="Collapsed" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" Click="PreviewMode_Click" ToolTipService.ToolTip="Anteprima Markdown (Ctrl+Maiusc+V)">
                    <PathIcon Width="15" Height="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Data="M3.25909 11.6021C3.94254 8.32689 6.79437 6 10 6C13.2057 6 16.0574 8.32688 16.7409 11.6021C16.7974 11.8725 17.0622 12.0459 17.3325 11.9895C17.6029 11.933 17.7763 11.6682 17.7199 11.3979C16.9425 7.67312 13.6934 5 10 5C6.3066 5 3.05742 7.67311 2.28017 11.3979C2.22377 11.6682 2.39718 11.933 2.6675 11.9895C2.93782 12.0459 3.20268 11.8725 3.25909 11.6021ZM10 8C8.067 8 6.5 9.567 6.5 11.5C6.5 13.433 8.067 15 10 15C11.933 15 13.5 13.433 13.5 11.5C13.5 9.567 11.933 8 10 8ZM7.5 11.5C7.5 10.1193 8.61929 9 10 9C11.3807 9 12.5 10.1193 12.5 11.5C12.5 12.8807 11.3807 14 10 14C8.61929 14 7.5 12.8807 7.5 11.5Z"/>
                </Button>
                <AppBarButton x:Uid="SaveBtn" x:Name="SaveBtn" ToolTipService.ToolTip="Salva (Ctrl+S)" Click="Save_Click" Width="36" Height="36" IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="SearchBtn" ToolTipService.ToolTip="Cerca (Ctrl+F)" Click="Find_Click" Width="36" Height="36">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="ThemeBtn" x:Name="ThemeButton" ToolTipService.ToolTip="Tema chiaro/scuro" Click="ThemeButton_Click" Width="36" Height="36">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="ThemeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE708;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="SettingsBtn" ToolTipService.ToolTip="Impostazioni" Click="Settings_Click" Width="36" Height="36">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </StackPanel>
        </Grid>

        <!-- ===== EDITOR (content host + pinned overlays: never removed) ===== -->
        <Grid Grid.Row="2" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
            <Grid x:Name="EditorHost"/>
            <WebView2 x:Name="PreviewView" Visibility="Collapsed"/>
            <Border x:Name="FindBar" Style="{StaticResource OverlayCard}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,16,0" Padding="8" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox x:Uid="FindBox" x:Name="FindBox" Width="170" PlaceholderText="Cerca"
                             TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
                    <Button x:Uid="FindPrevBtn" Content="&#xE70D;" FontFamily="Segoe Fluent Icons" Width="32" Click="FindPrev_Click" ToolTipService.ToolTip="Precedente"/>
                    <Button x:Uid="FindNextBtn" Content="&#xE70E;" FontFamily="Segoe Fluent Icons" Width="32" Click="FindNext_Click" ToolTipService.ToolTip="Successivo"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Width="32" Click="FindClose_Click"/>
                </StackPanel>
            </Border>
            <!-- Preview error (never removed: outside EditorHost) -->
            <Border x:Name="PreviewError" Style="{StaticResource OverlayCard}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20" CornerRadius="8" MaxWidth="420">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PreviewErrorText" TextWrapping="WrapWholeWords"/>
                    <Button Content="Riprova" Click="PreviewRetry_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Grid x:Name="StatusRow" Grid.Row="3" Padding="12,4,8,4" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Uid="LnCol" x:Name="LnCol" Text="Riga 1, col. 1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Rectangle Style="{StaticResource StatusSep}"/>
                <TextBlock x:Uid="CharCount" x:Name="CharCount" Text="0 caratteri" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Rectangle Style="{StaticResource StatusSep}"/>
                <TextBlock x:Uid="FileTypeLabel" x:Name="FileTypeLabel" Text="Testo normale" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button x:Name="ZoomOutBtn" Content="&#xE949;" FontFamily="Segoe Fluent Icons" FontSize="11" Padding="6,2" Click="ZoomOut_Click"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Width="42" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="ZoomInBtn" Content="&#xE948;" FontFamily="Segoe Fluent Icons" FontSize="11" Padding="6,2" Click="ZoomIn_Click"/>
                <Rectangle Style="{StaticResource StatusSep}"/>
                <TextBlock x:Uid="LineEndLabel" x:Name="LineEndLabel" Text="Windows (CRLF)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Rectangle Style="{StaticResource StatusSep}"/>
                <TextBlock x:Uid="EncodingLabel" x:Name="EncodingLabel" Text="UTF-8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ===== SETTINGS ===== -->
        <ContentDialog x:Uid="SettingsDialog" x:Name="SettingsDialog" Title="Impostazioni" CloseButtonText="Chiudi" DefaultButton="Close">
            <StackPanel Spacing="8" MinWidth="260">
                <TextBlock x:Uid="SetAppearance" Text="Aspetto" FontWeight="SemiBold"/>
                <TextBlock x:Uid="SetTheme" Text="Tema app"/>
                <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_Changed" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="SetLight" Content="Chiaro"/>
                    <ComboBoxItem x:Uid="SetDark" Content="Scuro"/>
                    <ComboBoxItem x:Uid="SetSystem" Content="Segui Windows" IsSelected="True"/>
                </ComboBox>
                <TextBlock x:Uid="SetEditor" Text="Editor" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <CheckBox x:Uid="WrapCheck" x:Name="WrapCheck" Content="A capo automatico" IsChecked="True" Checked="Wrap_Changed" Unchecked="Wrap_Changed"/>
                <TextBlock x:Uid="SetFontSize" Text="Dimensione carattere"/>
                <Slider x:Name="FontSlider" Minimum="12" Maximum="24" Value="15" ValueChanged="FontSlider_Changed"/>
            </StackPanel>
        </ContentDialog>
    </local:CursorGrid>
</Window>
