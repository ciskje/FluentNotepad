<Window
    x:Class="FluentNotepad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TITLE BAR con TabView (come Notepad) ===== -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="Transparent">
            <controls:TabView
                xmlns:controls="using:Microsoft.UI.Xaml.Controls"
                x:Name="Tabs" Background="Transparent" Margin="4,6,150,0"
                VerticalAlignment="Stretch"
                IsAddTabButtonVisible="True" CanReorderTabs="True" CanDragTabs="True"
                AddTabButtonClick="Tabs_AddTab" TabCloseRequested="Tabs_Close"
                SelectionChanged="Tabs_SelectionChanged">
                <controls:TabView.TabStripHeader>
                    <Image Source="Assets/AppIcon.ico" Width="16" Height="16" Margin="8,0,4,0"/>
                </controls:TabView.TabStripHeader>
            </controls:TabView>
        </Grid>

        <!-- ===== MENU + FORMATTAZIONE (velo bianco/nero su Mica come Notepad) ===== -->
        <Grid x:Name="MenuRow" Grid.Row="1" Padding="8,2,4,2" BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <MenuBar>
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="Nuova scheda" Click="NewTab_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="T" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Apri…" Click="Open_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Salva" Click="Save_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Salva con nome…" Click="SaveAs_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Chiudi scheda" Click="CloseTab_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="W" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Esci" Click="Exit_Click"/>
                </MenuBarItem>
                <MenuBarItem Title="Modifica">
                    <MenuFlyoutItem Text="Annulla" Click="Undo_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Ripeti" Click="Redo_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Y" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Taglia" Click="Cut_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="X" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Copia" Click="Copy_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="C" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Incolla" Click="Paste_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="V" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Trova…" Click="Find_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Seleziona tutto" Click="SelectAll_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="A" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem Title="Visualizza">
                    <MenuFlyoutItem Text="Aumenta zoom" Click="ZoomIn_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Add" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Riduci zoom" Click="ZoomOut_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Subtract" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Ripristina zoom" Click="ZoomReset_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number0" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Anteprima Markdown" Click="PreviewToggle_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="V" Modifiers="Control,Shift"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="WrapMenuItem" Text="A capo automatico" Click="Wrap_Click"/>
                </MenuBarItem>
            </MenuBar>

            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed"
                        OverflowButtonVisibility="Collapsed" HorizontalAlignment="Center">
                <AppBarButton Content="H" FontFamily="Segoe UI" FontWeight="Bold" ToolTipService.ToolTip="Titolo (#)" Click="FormatHeading_Click"/>
                <AppBarButton Content="B" FontFamily="Segoe UI" FontWeight="Bold" ToolTipService.ToolTip="Grassetto (**testo**)" Click="FormatBold_Click"/>
                <AppBarButton Content="I" FontFamily="Segoe UI" FontStyle="Italic" ToolTipService.ToolTip="Corsivo (*testo*)" Click="FormatItalic_Click"/>
                <AppBarButton Content="S" FontFamily="Segoe UI" ToolTipService.ToolTip="Barrato (~~testo~~)" Click="FormatStrike_Click"/>
                <AppBarButton ToolTipService.ToolTip="Link [testo](url)" Click="FormatLink_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Content="&#x275D;" FontFamily="Segoe UI" ToolTipService.ToolTip="Citazione (> )" Click="FormatQuote_Click"/>
                <AppBarButton ToolTipService.ToolTip="Elenco puntato (- )" Click="FormatBullets_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Content="1." FontFamily="Segoe UI" ToolTipService.ToolTip="Elenco numerato (1. )" Click="FormatNumbers_Click"/>
                <AppBarButton Content="{}{ }" FontFamily="Consolas" ToolTipService.ToolTip="Codice (`testo`)" Click="FormatCode_Click"/>
            </CommandBar>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="MdToggle" Visibility="Collapsed" CornerRadius="6" Padding="2" Margin="0,0,4,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EditModeBtn" Content="Modifica" Click="EditMode_Click" ToolTipService.ToolTip="Modalità modifica"/>
                        <Button x:Name="PreviewModeBtn" Content="Anteprima" Click="PreviewMode_Click" ToolTipService.ToolTip="Anteprima Markdown (Ctrl+Maiusc+V)"/>
                    </StackPanel>
                </Border>
                <AppBarButton ToolTipService.ToolTip="Cerca (Ctrl+F)" Click="Find_Click" Width="40">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ThemeButton" ToolTipService.ToolTip="Tema chiaro/scuro" Click="ThemeButton_Click" Width="40">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="ThemeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE708;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton ToolTipService.ToolTip="Impostazioni" Click="Settings_Click" Width="40">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </StackPanel>
        </Grid>

        <!-- ===== EDITOR (host contenuto + overlay fissi: non vengono mai rimossi) ===== -->
        <Grid Grid.Row="2" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
            <Grid x:Name="EditorHost"/>
            <WebView2 x:Name="PreviewView" Visibility="Collapsed"/>
            <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,16,0" Padding="8" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox x:Name="FindBox" Width="170" PlaceholderText="Cerca"
                             TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
                    <Button Content="&#xE70D;" FontFamily="Segoe Fluent Icons" Width="32" Click="FindPrev_Click" ToolTipService.ToolTip="Precedente"/>
                    <Button Content="&#xE70E;" FontFamily="Segoe Fluent Icons" Width="32" Click="FindNext_Click" ToolTipService.ToolTip="Successivo"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Width="32" Click="FindClose_Click"/>
                </StackPanel>
            </Border>
            <!-- Errore anteprima (mai rimosso: fuori da EditorHost) -->
            <Border x:Name="PreviewError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20" CornerRadius="8" BorderThickness="1" MaxWidth="420"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PreviewErrorText" TextWrapping="WrapWholeWords"/>
                    <Button Content="Riprova" Click="PreviewRetry_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Grid x:Name="StatusRow" Grid.Row="3" Padding="12,4,8,4" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="LnCol" Text="Riga 1, col. 1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="CharCount" Text="0 caratteri" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock x:Name="FileTypeLabel" Text="Testo normale" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button Content="&#xE949;" FontFamily="Segoe Fluent Icons" FontSize="11" Padding="6,2" Click="ZoomOut_Click" ToolTipService.ToolTip="Riduci zoom"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Width="42" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="&#xE948;" FontFamily="Segoe Fluent Icons" FontSize="11" Padding="6,2" Click="ZoomIn_Click" ToolTipService.ToolTip="Aumenta zoom"/>
                <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Text="Windows (CRLF)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Text="UTF-8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ===== IMPOSTAZIONI ===== -->
        <ContentDialog x:Name="SettingsDialog" Title="Impostazioni" CloseButtonText="Chiudi" DefaultButton="Close">
            <StackPanel Spacing="8" MinWidth="260">
                <TextBlock Text="Aspetto" FontWeight="SemiBold"/>
                <TextBlock Text="Tema app"/>
                <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_Changed" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Chiaro"/>
                    <ComboBoxItem Content="Scuro"/>
                    <ComboBoxItem Content="Segui Windows" IsSelected="True"/>
                </ComboBox>
                <TextBlock Text="Editor" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <CheckBox x:Name="WrapCheck" Content="A capo automatico" IsChecked="True" Checked="Wrap_Changed" Unchecked="Wrap_Changed"/>
                <TextBlock Text="Dimensione carattere"/>
                <Slider x:Name="FontSlider" Minimum="12" Maximum="24" Value="15" ValueChanged="FontSlider_Changed"/>
                <TextBlock Text="Informazioni" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock x:Name="VersionInfo" Text="FluentNotepad" TextWrapping="WrapWholeWords"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
