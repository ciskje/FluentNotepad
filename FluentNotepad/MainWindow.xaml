<Window x:Class="FluentNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluentNotepad" Height="650" Width="1000"
        MinHeight="450" MinWidth="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        Icon="icona.ico"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" CaptionHeight="0"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="OuterBorder" Background="{DynamicResource AppBgBrush}" CornerRadius="8"
            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ===== RIGA TAB (come Notepad: linguette + pulsanti finestra) ===== -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    CornerRadius="7,7,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
              <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- icona + linguette + "+" subito dopo l'ultima tab -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Image Source="icona.ico" Width="16" Height="16"
                           VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"
                                ItemContainerStyle="{StaticResource FluentTabItem}"
                                SelectionChanged="Tabs_SelectionChanged" Margin="0"
                                VerticalAlignment="Stretch">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </ControlTemplate>
                        </TabControl.Template>
                    </TabControl>
                    <Button Content="&#xE710;" Style="{StaticResource IconButton}"
                            Width="32" Height="32" Margin="4,0,0,0" VerticalAlignment="Center"
                            ToolTip="Nuova scheda (Ctrl+T)" Click="NewTab_Click"/>
                </StackPanel>
                <!-- area trascinabile -->
                <Border Grid.Column="1" Background="Transparent"/>
                <!-- pulsanti finestra -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Content="&#xE921;" Style="{StaticResource WinButton}" Height="40" Click="MinButton_Click"/>
                    <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource WinButton}" Height="40" Click="MaxButton_Click"/>
                    <Button Content="&#xE8BB;" Click="CloseButton_Click" FontSize="10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WinButton}">
                                <Setter Property="Height" Value="40"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ===== RIGA MENU + FORMATTAZIONE (come Notepad) ===== -->
            <Border Grid.Row="1" Background="{DynamicResource MenuBarBrush}"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="File" Style="{StaticResource MenuBtn}" Click="FileMenu_Click"/>
                        <Button Content="Modifica" Style="{StaticResource MenuBtn}" Click="EditMenu_Click"/>
                        <Button Content="Visualizza" Style="{StaticResource MenuBtn}" Click="ViewMenu_Click"/>
                    </StackPanel>
                    <!-- barra formattazione Markdown -->
                    <StackPanel x:Name="FormatBar" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="H" FontFamily="Segoe UI" FontWeight="Bold" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Titolo (#)" Click="FormatHeading_Click"/>
                        <Button Content="B" FontFamily="Segoe UI" FontWeight="Bold" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Grassetto (**testo**)" Click="FormatBold_Click"/>
                        <Button Content="I" FontStyle="Italic" FontFamily="Segoe UI" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Corsivo (*testo*)" Click="FormatItalic_Click"/>
                        <Button FontFamily="Segoe UI" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Barrato (~~testo~~)" Click="FormatStrike_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="S" TextDecorations="Strikethrough"/>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Content="&#xE71B;" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Link [testo](url)" Click="FormatLink_Click"/>
                        <Button Content="&#x275D;" FontFamily="Segoe UI" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Citazione (> )" Click="FormatQuote_Click"/>
                        <Button Content="&#xE8FD;" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Elenco puntato (- )" Click="FormatBullets_Click"/>
                        <Button Content="1." FontFamily="Segoe UI" FontSize="12" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Elenco numerato (1. )" Click="FormatNumbers_Click"/>
                        <Button Content="{}{ }" FontFamily="Consolas, Segoe UI" FontSize="12" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Codice (`testo`)" Click="FormatCode_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Border x:Name="MdToggle" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6"
                                Padding="2" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="EditModeBtn" Content="Modifica" Style="{StaticResource MenuBtn}" Click="EditMode_Click" ToolTip="Modalità modifica"/>
                                <Button x:Name="PreviewModeBtn" Content="Anteprima" Style="{StaticResource MenuBtn}" Click="PreviewMode_Click" ToolTip="Anteprima Markdown (Ctrl+Maiusc+V)"/>
                            </StackPanel>
                        </Border>
                        <Button Content="&#xE721;" Style="{StaticResource IconButton}" ToolTip="Cerca (Ctrl+F)" Click="FindButton_Click"/>
                        <Button x:Name="ThemeButton" Content="&#xE708;" Style="{StaticResource IconButton}" ToolTip="Tema chiaro/scuro" Click="ThemeButton_Click"/>
                        <Button Content="&#xE713;" Style="{StaticResource IconButton}" ToolTip="Impostazioni" Click="SettingsButton_Click" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Menu popup -->
            <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=TitleBar}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="4" MinWidth="230">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel x:Name="MenuPanel"/>
                </Border>
            </Popup>

            <!-- ===== EDITOR (tutto schermo, senza margini laterali come Notepad) ===== -->
            <Grid Grid.Row="2" Background="{DynamicResource EditorBrush}">
                <!-- Contenuto della scheda selezionata (TabItem.Content: editor o griglia editor+anteprima) -->
                <ContentControl x:Name="EditorHost"
                                Content="{Binding SelectedItem.Content, ElementName=Tabs}"/>
                <!-- Barra di ricerca overlay -->
                <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,16,0" Background="{DynamicResource CardBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="170" Padding="8,6" FontSize="12.5"
                                 Background="{DynamicResource LayerBrush}" Foreground="{DynamicResource ForeBrush}"
                                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                 TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
                        <Button Content="&#xE70D;" Style="{StaticResource IconButton}" Width="32" Height="32" Click="FindPrev_Click" ToolTip="Precedente"/>
                        <Button Content="&#xE70E;" Style="{StaticResource IconButton}" Width="32" Height="32" Click="FindNext_Click" ToolTip="Successivo"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Width="32" Height="32" Click="FindClose_Click"/>
                    </StackPanel>
                </Border>
                <!-- Drawer impostazioni -->
                <Border x:Name="SettingsDrawer" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Width="290" Margin="0,0,0,0" Background="{DynamicResource CardBrush}"
                        BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Impostazioni" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForeBrush}"/>
                        <TextBlock Text="Aspetto" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="{DynamicResource ForeBrush}"/>
                        <TextBlock Text="Tema app" Foreground="{DynamicResource SubtleForeBrush}" FontSize="12"/>
                        <ComboBox x:Name="ThemeCombo" Margin="0,6,0,0" SelectionChanged="ThemeCombo_Changed">
                            <ComboBoxItem Content="Chiaro"/>
                            <ComboBoxItem Content="Scuro"/>
                            <ComboBoxItem Content="Segui Windows" IsSelected="True"/>
                        </ComboBox>
                        <TextBlock Text="Editor" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="{DynamicResource ForeBrush}"/>
                        <CheckBox x:Name="WrapCheck" Content="A capo automatico" IsChecked="True" Checked="Wrap_Changed" Unchecked="Wrap_Changed" Margin="0,4"/>
                        <TextBlock Text="Dimensione carattere" Foreground="{DynamicResource SubtleForeBrush}" FontSize="12" Margin="0,10,0,0"/>
                        <Slider x:Name="FontSlider" Minimum="12" Maximum="24" Value="15" Margin="0,6,0,0" ValueChanged="FontSlider_Changed"/>
                        <TextBlock Text="Informazioni" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="{DynamicResource ForeBrush}"/>
                        <TextBlock x:Name="VersionInfo" Text="FluentNotepad" TextWrapping="Wrap" Foreground="{DynamicResource SubtleForeBrush}" FontSize="12"/>
                        <Button Content="Chiudi" Margin="0,24,0,0" Padding="0,8" Click="SettingsButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== STATUS BAR (segmenti come Notepad) ===== -->
            <Border Grid.Row="3" Background="{DynamicResource StatusBarBrush}" CornerRadius="0,0,8,8"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LnCol" Text="Riga 1, col. 1" FontSize="12" Foreground="{DynamicResource SubtleForeBrush}"/>
                        <Border Width="1" Height="16" Margin="10,0" Background="{DynamicResource BorderBrush}"/>
                        <TextBlock x:Name="CharCount" Text="0 caratteri" FontSize="12" Foreground="{DynamicResource SubtleForeBrush}"/>
                        <Border Width="1" Height="16" Margin="10,0" Background="{DynamicResource BorderBrush}"/>
                        <TextBlock x:Name="FileTypeLabel" Text="Testo normale" FontSize="12" Foreground="{DynamicResource SubtleForeBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE949;" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="11" Click="ZoomOut_Click" ToolTip="Riduci zoom"/>
                        <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" VerticalAlignment="Center" Width="42" TextAlignment="Center" Foreground="{DynamicResource SubtleForeBrush}"/>
                        <Button Content="&#xE948;" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="11" Click="ZoomIn_Click" ToolTip="Aumenta zoom"/>
                        <Border Width="1" Height="16" Margin="10,0" Background="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="Windows (CRLF)" FontSize="12" Foreground="{DynamicResource SubtleForeBrush}"/>
                        <Border Width="1" Height="16" Margin="10,0" Background="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="UTF-8" FontSize="12" Foreground="{DynamicResource SubtleForeBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
